# Server
PORT=3000

# CORS
CORS_ORIGIN=http://localhost:5173

# Database (Postgres from docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/food_delivery_db?schema=public"

# JWT
ACCESS_TOKEN_SECRET=your_super_secret_access_key_123
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_456
ACCESS_TOKEN_SECRET_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET_EXPIRES_IN="24h"
